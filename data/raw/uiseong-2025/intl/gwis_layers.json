[
  {
    "name": "GWIS",
    "title": "GWIS",
    "abstract": "The Global Wildfire Information System (GWIS) supports the services in charge of the protection of forests against fires and provides the European Commission services and the European Parliament with updated and reliable information on wildland fires at the global level.",
    "time_extent": null,
    "queryable": "1"
  },
  {
    "name": "ecmwf.fwi",
    "title": "ecmwf.fwi",
    "abstract": "Fire Weather Index (FWI) from ECMWF reanalysis data. The FWI is a numerical rating of fire intensity and potential fire behavior, based on weather conditions such as temperature, humidity, wind speed, and precipitation. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.ffmc",
    "title": "ecmwf.ffmc",
    "abstract": "Fine Fuel Moisture Code (FFMC) from ECMWF reanalysis data. The FFMC is a numerical rating of the moisture content of fine fuels, such as grass and leaves, which can influence the ignition and spread of wildfires. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.dmc",
    "title": "ecmwf.dmc",
    "abstract": "Duff Moisture Code (DMC) from ECMWF reanalysis data. The DMC is a numerical rating of the moisture content of medium-sized fuels, such as shrubs and small branches, which can influence the ignition and spread of wildfires. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.dc",
    "title": "ecmwf.dc",
    "abstract": "Drought Code (DC) from ECMWF reanalysis data. The DC is a numerical rating of the moisture content of deep, compacted organic layers, which can influence the ignition and spread of wildfires. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.isi",
    "title": "ecmwf.isi",
    "abstract": "Initial Spread Index (ISI) from ECMWF reanalysis data. The ISI is a numerical rating of the expected rate of fire spread immediately after ignition, based on weather conditions such as wind speed and fine fuel moisture content. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.bui",
    "title": "ecmwf.bui",
    "abstract": "Buildup Index (BUI) from ECMWF reanalysis data. The BUI is a numerical rating of the total amount of fuel available for combustion, based on weather conditions such as precipitation and temperature. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.ranking",
    "title": "ecmwf.ranking",
    "abstract": "Fire Weather Index (FWI) from ECMWF reanalysis data. The FWI is a numerical rating of fire intensity and potential fire behavior, based on weather conditions such as temperature, humidity, wind speed, and precipitation. It is commonly used in wildfire management and forecasting to assess fire risk and guide firefighting efforts.",
    "time_extent": "2018-01-01/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.extra.lightning",
    "title": "ecmwf.extra.lightning",
    "abstract": "The GWIS ECMWF Lightning layer provides a near-real-time raster of lightning flash density derived from the European Centre for Medium-Range Weather Forecasts (ECMWF) Integrated Forecast System. Updated hourly, the product shows the estimated number of cloud-to-ground flashes per km² for the preceding 24 hours at a spatial resolution of approximately 0.1° (≈10 km). It covers the whole European Union and is intended to support the European Forest Fire Information System (EFFIS) by enhancing fire-danger mapping, early-warning alerts and operational decision-making where lightning-ignited fires are a significant risk.",
    "time_extent": "2019-11-05/2099-12-31",
    "queryable": "0"
  },
  {
    "name": "ecmwf.extra.totalprecipitation",
    "title": "ecmwf.extra.totalprecipitation",
    "abstract": "The GWIS ECMWF Total Precipitation layer provides a near-real-time forecast raster of accumulated precipitation derived from the European Centre for Medium-Range Weather Forecasts (ECMWF) Integrated Forecast System. Updated sub-daily, the product displays accumulated total precipitation in millimeters (mm) at a spatial resolution of approximately 0.07° (~7 km). It supports the European Forest Fire Information System (EFFIS) and Global Wildfire Information System (GWIS) for fire danger assessment and weather monitoring.",
    "time_extent": "2019-11-05 00:00:00/2099-12-31 23:00:00",
    "queryable": "0"
  },
  {
    "name": "ecmwf.extra.windspeed",
    "title": "ecmwf.extra.windspeed",
    "abstract": "The GWIS ECMWF 10m Wind Speed layer provides a near-real-time forecast raster of 10-meter wind speed derived from the European Centre for Medium-Range Weather Forecasts (ECMWF) Integrated Forecast System. Updated sub-daily, the product displays 10m wind speed in meters per second (m/s) at a spatial resolution of approximately 0.07° (~7 km). It supports the European Forest Fire Information System (EFFIS) and Global Wildfire Information System (GWIS) for fire danger assessment and weather monitoring.",
    "time_extent": "2019-11-05 00:00:00/2099-12-31 23:00:00/PT6H",
    "queryable": "0"
  },
